#!/bin/sh
# ROM-handling guard (AGENTS.md): refuse to PUSH ROMs, saves, dumps or unexplained binaries, even if an earlier commit slipped through.
HERE="$(cd "$(dirname "$0")" && pwd)"
ZERO=0000000000000000000000000000000000000000
STATUS=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ "$LOCAL_SHA" = "$ZERO" ] && continue
    if [ "$REMOTE_SHA" = "$ZERO" ] || ! git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
        FIRST="$(git rev-list --reverse "$LOCAL_SHA" --not --remotes | head -n 1)"
        [ -z "$FIRST" ] && continue
        if git rev-parse -q --verify "$FIRST^" >/dev/null 2>&1; then BASE="$FIRST^"; else BASE="$(git hash-object -t tree /dev/null)"; fi
    else
        BASE="$REMOTE_SHA"
    fi
    "$HERE/run-guard.sh" Range -Base "$BASE" -Head "$LOCAL_SHA" || STATUS=1
done
exit $STATUS
